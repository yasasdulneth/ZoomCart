{
  "name": "zoomcart",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "postinstall": "npx expo install --fix",
    "prestart": "node -e \"try { require('expo') } catch(e) { console.error('Expo not found! Run: npm install'); process.exit(1); }\"",
    "start": "node scripts/start-with-lan.js",
    "start:lan": "npx expo start --lan",
    "start:tunnel": "npx expo start --tunnel",
    "start:clear": "npx expo start --clear --lan",
    "start:localhost": "npx expo start --localhost",
    "start:dev": "npx expo start --lan --dev-client",
    "android": "npx expo start --android --lan",
    "ios": "npx expo start --ios --lan",
    "web": "npx expo start --web",
    "setup": "npm install && npx expo install --fix",
    "typecheck": "tsc --noEmit && cd backend && tsc --noEmit",
    "typecheck:app": "tsc --noEmit",
    "typecheck:backend": "cd backend && tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.9.15",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.2.0",
    "@stripe/stripe-react-native": "0.50.3",
    "expo": "~54.0.34",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.0",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.0",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.8",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "i18next": "^26.1.0",
    "react": "19.1.0",
    "react-i18next": "^17.0.7",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/cli": "^0.11.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.6.0",
    "@types/react": "~19.1.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true
}
